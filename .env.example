# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit real secrets. .env* files are gitignored (this example is not).

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public app URL (no trailing slash). Used for Stripe return URLs and magic links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------
# Local dev: SQLite file in the project root.
DATABASE_URL="file:./dev.db"
# Production (after switching provider to "postgresql" in prisma/schema.prisma):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# -----------------------------------------------------------------------------
# Auth (Auth.js / next-auth v5)
# -----------------------------------------------------------------------------
# Required. Generate with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=replace-with-a-long-random-string
# Needed when self-hosting behind a proxy / running `next start` (Vercel sets this automatically).
# AUTH_TRUST_HOST=true

# Dev-only password-less login for seeded example accounts. Ignored when
# NODE_ENV=production. NEVER set this in a deployed environment.
AUTH_DEV_LOGIN=true

# Magic-link email. If EMAIL_SERVER is unset, NO email is sent and the sign-in
# link is printed to the server console instead (local dev).
# EMAIL_SERVER=smtp://USERNAME:PASSWORD@smtp.example.com:587
# EMAIL_FROM="Scars of Valor Foundation <no-reply@scarsofvalor.org>"

# -----------------------------------------------------------------------------
# File storage (profile photos, unit wall photos)
# -----------------------------------------------------------------------------
# "local" = files on disk under UPLOADS_DIR (gitignored). Fine for dev and for a
# single long-lived server. Serverless hosts (Vercel) need an object-storage
# driver (S3 / R2 / Vercel Blob) — see README "File storage".
STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Leave STRIPE_SECRET_KEY unset in local dev: the Join flow then records the
# member locally and makes NO Stripe API calls.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret for the /api/stripe/webhook endpoint (Stripe Dashboard → Webhooks).
# STRIPE_WEBHOOK_SECRET=whsec_...

# Annual subscription Price IDs (Stripe Dashboard → Products). These defaults are
# also hard-coded in src/lib/tiers.ts.
STRIPE_PRICE_COMMUNITY_SUPPORTER=price_1UGVk6LJOUo405o6bzERgjFC
STRIPE_PRICE_GUARDIAN=price_1UGVkBLJOUo405o6Q1SAG0x1
STRIPE_PRICE_LEGACY=price_1UGVkGLJOUo405o6vhRZYQlV
